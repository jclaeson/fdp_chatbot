# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-sonnet-*

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Vector Store
CHROMA_PERSIST_DIR=../rag/chroma_db
CHROMA_COLLECTION_NAME=fedex_docs

# Retrieval Settings
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.5

# Routing Strategy
USE_INTELLIGENT_ROUTING=true
COMPLEXITY_THRESHOLD=0.7
MAX_OLLAMA_RETRIES=2

# CORS (JSON array format required)
CORS_ORIGINS=["*"]
